<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup configuration for Zamolxis

  SECURITY POLICY:
  - zamolxis_database: EXCLUDED. It is encrypted at rest with SQLCipher under a
    passphrase held in the Android Keystore, and a Keystore key never leaves the
    device it was generated on. A copy restored onto other hardware could not be
    opened by anything, so backing it up would only put the messages in Google's
    cloud without buying the user a working restore. files/zamolxis_database.key
    (the wrapped passphrase) is excluded for the same reason.
    Consequence, and it is deliberate: message history, conversations and contacts
    do not survive a device transfer. There is no encrypted-export flow yet.
  - Other Room databases: BACKED UP
    * interface_database: user-configured RNS interfaces.
    * reticulum.db: RNS routing state (paths, announces, packet
      hashlist, tunnels, known destinations, identity ratchets,
      destination ratchets for LXMF forward secrecy).
  - SharedPreferences: BACKED UP
  - Files under files/: BACKED UP apart from the database passphrase
  - Cache: EXCLUDED (Android default)

  The files/reticulum/ exclusion that earlier versions needed is gone:
  - the in-memory-identity refactor (PR #785) stopped writing delivery
    identity files,
  - reticulum-kt v0.0.5 moved RNS routing state to Room,
  - reticulum-kt v0.0.6 moved LXMF delivery-destination ratchets to Room,
  - the createIdentityWithName / importIdentityFile / recoverIdentityFile
    refactor eliminated the last plaintext-file writers.

  Nothing in files/reticulum/ contains user secrets anymore.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />

        <exclude domain="database" path="zamolxis_database" />
        <exclude domain="database" path="zamolxis_database-wal" />
        <exclude domain="database" path="zamolxis_database-shm" />
        <exclude domain="file" path="zamolxis_database.key" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />

        <exclude domain="database" path="zamolxis_database" />
        <exclude domain="database" path="zamolxis_database-wal" />
        <exclude domain="database" path="zamolxis_database-shm" />
        <exclude domain="file" path="zamolxis_database.key" />
    </device-transfer>
</data-extraction-rules>
