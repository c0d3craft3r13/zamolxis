<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup configuration for Zamolxis

  SECURITY POLICY:
  - zamolxis_database: EXCLUDED. It is encrypted at rest with SQLCipher under a
    passphrase held in the Android Keystore, and a Keystore key never leaves the
    device it was generated on. A copy restored onto other hardware could not be
    opened by anything, so backing it up would only put the messages in Google's
    cloud without buying the user a working restore. files/zamolxis_database.key
    (the wrapped passphrase) is excluded for the same reason.
    Consequence, and it is deliberate: message history, conversations and contacts
    do not survive a device transfer. There is no encrypted-export flow yet.
  - Other Room databases: BACKED UP
    * interface_database: user-configured RNS interfaces.
    * reticulum.db: RNS routing state (paths, announces, packet
      hashlist, tunnels, known destinations, identity ratchets,
      destination ratchets for LXMF forward secrecy).
  - SharedPreferences: BACKED UP
  - Files under files/: BACKED UP apart from the database passphrase
  - Cache: EXCLUDED (Android default)

  files/reticulum/ is EXCLUDED again. The claim that "nothing there contains
  secrets anymore" held only for the kotlinBackend flavor, whose reticulum-kt
  moved routing state to Room. The SHIPPED release is pythonBackend, and upstream
  Python RNS writes its own storage tree to files/reticulum/reticulum/storage/ —
  including transport_identity (the node's transport Identity, i.e. a PRIVATE key)
  and ratchets/ (per-destination forward-secrecy private state). With
  `<include domain="file" path="."/>` those were being swept into cloud backup and
  device-transfer, i.e. a private key leaving the device into Google's cloud — the
  exact thing the SQLCipher/Keystore policy above exists to prevent. The routing
  caches next to them (destination_table, known_destinations) are re-derivable, so
  excluding the whole subtree costs nothing and closes the leak. Harmless for
  kotlinBackend, where the tree is effectively empty.

  Historical note on why the exclusion had been removed:
  - the in-memory-identity refactor (PR #785) stopped writing delivery
    identity files,
  - reticulum-kt v0.0.5 moved RNS routing state to Room,
  - reticulum-kt v0.0.6 moved LXMF delivery-destination ratchets to Room.
  All kotlinBackend-only — none of it applies to the Python stack that ships.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />

        <exclude domain="database" path="zamolxis_database" />
        <exclude domain="database" path="zamolxis_database-wal" />
        <exclude domain="database" path="zamolxis_database-shm" />
        <exclude domain="file" path="zamolxis_database.key" />
        <!-- Python RNS private key + forward-secrecy ratchets; never to the cloud. -->
        <exclude domain="file" path="reticulum" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />

        <exclude domain="database" path="zamolxis_database" />
        <exclude domain="database" path="zamolxis_database-wal" />
        <exclude domain="database" path="zamolxis_database-shm" />
        <exclude domain="file" path="zamolxis_database.key" />
        <!-- Python RNS private key + forward-secrecy ratchets; never off the device. -->
        <exclude domain="file" path="reticulum" />
    </device-transfer>
</data-extraction-rules>
