    </license>
  </licenses>
  <developers>
    <developer>
      <id>torlando-tech</id>
      <name>Torlando</name>
      <email></email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/torlando-tech/LXMF-kt.git</connection>
    <developerConnection>scm:git://github.com/torlando-tech/LXMF-kt.git</developerConnection>
    <url>git://github.com/torlando-tech/LXMF-kt.git</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.github.torlando-tech.reticulum-kt</groupId>
      <artifactId>rns-core</artifactId>
      <version>v0.0.22</version>
      <scope>compile</scope>
    </dependency>
