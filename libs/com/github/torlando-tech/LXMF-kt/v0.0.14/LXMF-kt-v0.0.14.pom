  <version>v0.0.14</version>
  <name>torlando-tech/LXMF-kt</name>
  <description>The Reticulum messaging protocol LXMF written in Kotlin for Android</description>
  <url>https://github.com/torlando-tech/LXMF-kt</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
