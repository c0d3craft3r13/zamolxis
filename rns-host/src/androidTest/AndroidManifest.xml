<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Everything here exists for one measurement: whether a foreground service
        keeps a Bluetooth scan running on a device that has gone to sleep. An
        ordinary app's scan is suspended there, and the zero it returns looks
        exactly like an empty room. Whether the service the app actually ships
        escapes that is not a thing to assume.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".emission.ScanProbeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
