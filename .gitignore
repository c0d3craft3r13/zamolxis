python/ble_modules/BLEFragmentation.py
.letta/
LINK_SPEED_PROBE_DESIGN.md
sentry-wizard

# Claude Code / claude-flow tooling
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/columba-python-migration/
.claude-flow/
.planning/
.swarm/
.mcp.json

# Release signing: credential side-files (the key itself is covered by *.jks/*.keystore)
keystore.properties
signing.properties
*.p12
*.pepk

# libs/ is a plain Maven repository for artifacts that are not on Maven Central.
# It has to be tracked, or the "builds with no network" promise in
# settings.gradle.kts is false: at one point only the .pom/.module metadata was
# committed and a fresh clone silently fell back to JitPack — exactly the
# dependency that vendoring was meant to remove. The Reticulum stack no longer
# lives here at all; it is built from source under vendor/.
!libs/**/*.jar
!libs/**/*.aar

# pip builds the vendored Python packages (vendor/python/) in place, leaving build/
# and *.egg-info inside the source trees. Those are build output, not vendored source
# — the trees themselves are tracked and must stay byte-identical to the upstream
# commits recorded in vendor/PROVENANCE.md.
vendor/python/*/build/
vendor/python/*/*.egg-info/
vendor/python/*/src/*.egg-info/
